<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="p1" name="C4 Deployment - Production"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2900" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="C4 Deployment diagram: BP Internet Banking (production, primary region and disaster recovery)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2200" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Where the containers run. Primary region is zone-redundant and serves traffic; the paired DR region is a warm standby that receives continuous replication. Instance counts are sizing assumptions for a mid-size bank." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Web browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Laptop or desktop&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#FFFFFF);strokeColor=light-dark(#5F6B7A,#5F6B7A);strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;fontSize=11;fontColor=light-dark(#1a1a1a,#1a1a1a);" vertex="1" parent="1"><mxGeometry x="40" y="110" width="320" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Angular SPA&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="280" height="44" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Mobile phone&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;iOS or Android&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#FFFFFF);strokeColor=light-dark(#5F6B7A,#5F6B7A);strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;fontSize=11;fontColor=light-dark(#1a1a1a,#1a1a1a);" vertex="1" parent="1"><mxGeometry x="40" y="240" width="320" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Flutter Mobile App&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="280" height="44" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure Front Door Premium&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Global edge, deployment node]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;WAF (OWASP rules, bots), DDoS protection, TLS 1.2+, health probes, priority routing with automatic failover to the DR region&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="760" height="120" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure Storage static website&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Deployment node behind Front Door]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Angular SPA and Back-Office Portal files, served through the CDN edge cache&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="110" width="460" height="120" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;BP data center (assumed on-premises)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Location of the Core is an assumption to confirm&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#FFFFFF);strokeColor=light-dark(#5F6B7A,#5F6B7A);strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;fontSize=11;fontColor=light-dark(#1a1a1a,#1a1a1a);" vertex="1" parent="1"><mxGeometry x="40" y="480" width="400" height="470" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Core Banking Platform&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[External: BP system]&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="360" height="70" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Customer Detail System&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[External: BP system]&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="360" height="70" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;BP Authorization Server&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[External: BP system]&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="360" height="70" as="geometry"/></mxCell><mxCell id="n14" value="The Authorization Server may also run in the cloud; the design only needs it reachable over the private link and highly available." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="60" y="820" width="360" height="100" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Azure region: South Central US (primary)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Serves production traffic; three availability zones&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="500" y="330" width="900" height="1290" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;API Management Premium&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Deployment node: API gateway, 2 units, zone-redundant]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;API Gateway container: JWT validation, scopes, rate limits, routing&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="400" width="840" height="100" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Azure Kubernetes Service cluster&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;3 availability zones, system and user node pools, autoscaling, node auto-repair&lt;/b&gt;&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#FFFFFF);strokeColor=light-dark(#5F6B7A,#5F6B7A);strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;fontSize=11;fontColor=light-dark(#1a1a1a,#1a1a1a);" vertex="1" parent="1"><mxGeometry x="530" y="540" width="840" height="250" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Web BFF x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="600" width="150" height="60" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Profile x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="707" y="600" width="150" height="60" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Movements x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="869" y="600" width="150" height="60" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Transfers x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1031" y="600" width="150" height="60" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Onboarding x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1193" y="600" width="150" height="60" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Notification x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="680" width="150" height="60" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Audit x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="707" y="680" width="150" height="60" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Frequent Client x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="869" y="680" width="150" height="60" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Risk and Limits x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1031" y="680" width="150" height="60" as="geometry"/></mxCell><mxCell id="n27" value="Containers deployed here: Web BFF and the eight microservices, spread across zones with pod anti-affinity" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="545" y="760" width="800" height="24" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Data and messaging&lt;/b&gt; &lt;span style=&quot;font-size:10px&quot;&gt;(private endpoints, managed identity, encryption with customer-managed keys)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#FFFFFF);strokeColor=light-dark(#5F6B7A,#5F6B7A);strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;fontSize=11;fontColor=light-dark(#1a1a1a,#1a1a1a);" vertex="1" parent="1"><mxGeometry x="530" y="840" width="840" height="590" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure SQL Database&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Transfers, Risk, Onboarding, Notification DBs and audit ledger; zone-redundant&lt;/font&gt;&lt;/div&gt;" style=