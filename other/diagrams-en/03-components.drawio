ntryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n42" value="alert" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#B45F06,#B45F06);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n43" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#0B6BCB,#0B6BCB);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);dashed=1;dashPattern=6 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.967741935483871;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="Audit Service"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="C4 Level 3 - Components: Audit Service" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Immutable, tamper-evident audit trail written asynchronously, read only through an audited query API, with a compliance reporting job." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="Audit Service   [Container: microservice, REST]" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="1820" height="1050" as="geometry"/></mxCell><mxCell id="n5" value="Entry points" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#FFF4D6,#FFF4D6);strokeColor=light-dark(#C9A227,#C9A227);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="170" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n6" value="Business layer: validate, archive, report, query" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E6F4EA,#E6F4EA);strokeColor=light-dark(#5BA36F,#5BA36F);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n7" value="Integration and data layer" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E4EEFB,#E4EEFB);strokeColor=light-dark(#5B8FD0,#5B8FD0);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="700" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;audit-events&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;every customer action&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="300" height="62" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;API Gateway&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: managed API gateway]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Staff calls, JWT with audit role&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2350" y="205" width="300" height="100" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Audit Event Consumer&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Service Bus subscriber, Idempotent Receiver]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Reads audit events; dead-letters malformed ones&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Audit Query API&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[REST, read-only, role-based access]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Search by customer, date, correlation ID; every query is itself audited&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1860" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Event Validator and Enricher&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Schema validation, hash chain]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Checks the schema, adds a timestamp, links each record to the previous hash&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Archive Writer and Digest&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: append-only archive]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Writes to immutable storage and stores daily hash digests separately&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Compliance Report Generator&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Scheduled job, rules]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Flags threshold and pattern cases and prepares reports for the authorities&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Audit Query Handler&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: CQRS query]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Reads the ledger; masks sensitive fields by role&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1860" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Ledger Writer&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Repository, append-only]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Inserts into SQL ledger tables; no updates or deletes exist in the code&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Archive Client&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Blob Storage SDK]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Immutable (WORM) retention policy&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Report Delivery Adapter&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Anti-Corruption Layer]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Secure file or API delivery to the regulatory authorities&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Ledger Reader&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Repository, read-only]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Read-only database identity&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1860" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Audit archive&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Blob Storage, immutable]&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="1285" width="240" height="90" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Audit ledger&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Azure SQL ledger tables]&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="1285" width="240" height="90" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Regulatory Authorities&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[External]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Mandatory reports&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="1290" width="300" height="90" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Separation of duties&lt;/b&gt;&lt;br&gt;The writer identity can only insert. The reader identity can only read. Operations staff cannot alter records." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="940" width="330" height="150" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Light blue boxes: components (code inside the container). Cylinders: data stores. Dashed blue: asynchronous event. Orange: call to an external system. Yellow band: API layer. Green band: business layer. Blue band: integration and data layer.&lt;br&gt;Bold text in each component gives its name, the line in brackets its technology or pattern." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="1450" width="2000" height="60" as="geometry"/></mxCell><mxCell id="n25" value="subscribes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#0B6BCB,#0B6BCB);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);dashed=1;dashPattern=6 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="HTTPS, mTLS&lt;br&gt;JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n27" value="event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="also archive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="append" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="report" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n34" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1770" y="660"/><mxPoint x="1920" y="660"/></Array></mxGeometry></mxCell><mxCell id="n35" value="SQL, TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#8A8A8A,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n21"><mxGeometry x="0.7" relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="1100"/><mxPoint x="1290" y="1100"/></Array></mxGeometry></mxCell><mxCell id="n36" value="SQL, TLS, read-only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#8A8A8A,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2010" y="1125"/><mxPoint x="1290" y="1125"/></Array></mxGeometry></mxCell><mxCell id="n37" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#8A8A8A,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n17" target="n20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="secure file or API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#B45F06,#B45F06);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="Web BFF"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="C4 Level 3 - Components: Web BFF (Backend for Frontend)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Keeps tokens on the server. The browser only holds a session cookie, so stolen page scripts cannot steal tokens." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Angular SPA&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: browser]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Holds only a session cookie, no tokens&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="110" width="300" height="100" as="geometry"/></mxCell><mxCell id="n5" value="Web BFF   [Container: Backend for Frontend, REST]" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="1320" height="530" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Session store&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Redis cache, encrypted]&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="350" width="260" height="90" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;CSRF Guard&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[SameSite cookie + anti-forgery header]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Rejects state-changing calls without the header&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="490" width="260" height="120" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Session Manager&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[HttpOnly, Secure, SameSite=Strict cookie]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Idle and absolute timeouts; server-side session&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="490" width="260" height="120" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;OIDC Client&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Authorization Code + PKCE, PAR, private_key_jwt]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Runs the login; confidential client&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="490" width="260" height="120" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;API Client&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Generated from OpenAPI]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Attaches the access token, correlation ID, idempotency key&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="680" width="260" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Aggregation Service&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Fan-out, one response per screen]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Combines profile, balances and movements calls&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="680" width="260" height="120" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Token Refresher&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Refresh-token rotation]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Renews tokens; revokes the session if reuse is detected&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="680" width="260" height="120" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;BP Authorization Server&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[External: OAuth 2.0 / OIDC]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Token endpoint&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1780" y="485" width="300" height="130" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;API Gateway&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: managed API gateway]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Validates the user token and routes the call&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="1000" width="300" height="110" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Light blue boxes: components (code inside the container). Cylinders: data stores. Dashed blue: asynchronous event. Orange: call to an external system. Yellow band: API layer. Green band: business layer. Blue band: integration and data layer.&lt;br&gt;Bold text in each component gives its name, the line in brackets its technology or pattern." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="1190" width="2000" height="60" as="geometry"/></mxCell><mxCell id="n16" value="Web API calls&lt;br&gt;HTTPS, session cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n7"><mxGeometry x="-0.5" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="valid request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="no session: sign in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#8A8A8A,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="session with tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="code exchange, OIDC + PKCE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#2E7D32,#2E7D32);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="HTTPS, mTLS&lt;br&gt;user token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="API Gateway"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="C4 Level 3 - Components: API Gateway (policy pipeline)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Every request passes the same ordered checks before it reaches a service. Requests that fail a step are rejected here." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Mobile App&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: Flutter]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Holds tokens in Keychain / Keystore&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="300" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Back-Office Portal&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: Angular web app]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Staff calls with SSO token&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="300" height="100" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Web BFF&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: Backend for Frontend]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Adds the user&amp;#x27;s access token&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="300" height="100" as="geometry"/></mxCell><mxCell id="n7" value="API Gateway   [Container: managed API gateway]" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="330" width="2080" height="300" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;1. JWT Validation&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Gateway policy]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Signature by cached JWKS, issuer, audience, expiry&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;2. Scope and Assurance Check&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Gateway policy]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Scope per API; acr for step-up on sensitive calls&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="695" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;3. Rate Limits and Quotas&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Gateway policy]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Per client, per customer, per IP&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;4. Schema Validation&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Gateway policy]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Request checked against the OpenAPI contract&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;5. Correlation and Logging&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Gateway policy]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;W3C trace context, masked logs&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;6. Routing and Versioning&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Gateway policy]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Path routing, /v1, canary&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1875" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;7. Backend mTLS&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Gateway policy]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Client certificate to services, private network&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2170" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;BP Authorization Server&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[External: OAuth 2.0 / OIDC]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Signing keys (JWKS)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="780" width="300" height="100" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Back-end services&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Containers: microservices]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Profile, Movements, Transfers, Onboarding, Notification, Audit&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="780" width="760" height="100" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Security boundaries&lt;/b&gt;&lt;br&gt;Callers to gateway: TLS, tokens, certificate pinning on mobile. Gateway to services: mTLS on a private network. Edge protection (WAF, DDoS) sits in front of the gateway and is shown in the Deployment diagram." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="900" y="760" width="700" height="120" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Light blue boxes: components (code inside the container). Cylinders: data stores. Dashed blue: asynchronous event. Orange: call to an external system. Yellow band: API layer. Green band: business layer. Blue band: integration and data layer.&lt;br&gt;Bold text in each component gives its name, the line in brackets its technology or pattern." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="980" width="2000" height="60" as="geometry"/></mxCell><mxCell id="n19" value="Mobile API calls&lt;br&gt;HTTPS, TLS 1.2+" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.26;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n8"><mxGeometry x="-0.2" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="User token&lt;br&gt;HTTPS, mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n8"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="300"/><mxPoint x="630" y="300"/></Array></mxGeometry></mxCell><mxCell id="n21" value="Staff calls&lt;br&gt;HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n8"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="285"/><mxPoint x=