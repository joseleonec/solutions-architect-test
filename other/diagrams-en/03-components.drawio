<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="p1" name="Transfers and Payments Service"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="C4 Level 3 - Components: Transfers and Payments Service" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Write side of the CQRS design. Pattern names appear in brackets. Security checks happen in the API layer; external systems are reached only through adapters." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="Transfers and Payments Service   [Container: microservice, REST, CQRS write side]" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="1820" height="1010" as="geometry"/></mxCell><mxCell id="n5" value="API layer: identity, authorization, step-up, idempotency" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#FFF4D6,#FFF4D6);strokeColor=light-dark(#C9A227,#C9A227);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="170" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n6" value="Business layer: CQRS command side, saga" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E6F4EA,#E6F4EA);strokeColor=light-dark(#5BA36F,#5BA36F);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n7" value="Integration and data layer: repository, outbox, adapters" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E4EEFB,#E4EEFB);strokeColor=light-dark(#5B8FD0,#5B8FD0);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="700" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;API Gateway&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: managed API gateway]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Validated JWT, rate limits, schema&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="300" height="100" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Authorization Filter&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Middleware: JWT claims, scopes, acr]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Checks scope transfers:create, that the account belongs to the caller, and the assurance level (step-up above threshold or new beneficiary)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Idempotency Filter&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Idempotent Receiver]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Rejects or replays requests with a repeated Idempotency-Key&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Transfers API Controller&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[REST controller: POST /v1/transfers, GET /v1/transfers/{id}]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Returns 202 Accepted with a status URL for interbank transfers&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Transfer Command Handler&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: CQRS command]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Validates, creates the transfer as PENDING and starts the saga&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Compensation Handler&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Saga compensation]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Releases reservations, reverses debits, raises manual-operations tasks&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Transfer Saga Orchestrator&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Saga (orchestrated), state machine]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;PENDING, DEBITED, SENT, COMPLETED, FAILED, REVERSED; timeouts and retries with backoff&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Reconciliation Job&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Scheduled job]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Compares transfers with Core records and interbank settlement reports&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Limits Client&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[REST client: circuit breaker, timeout]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Asks Risk and Limits for limits and risk decision before executing&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1860" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Outbox Publisher&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Transactional Outbox]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Reads unsent events written with the transfer and publishes them&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="745" width="300" height="120" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Transfer Repository&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Repository, SQL]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Saves transfer, saga state and outbox rows in one local ACID transaction&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="745" width="300" height="120" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Core Adapter&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Anti-Corruption Layer]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;REST client with retry, circuit breaker, bulkhead; maps Core model to domain&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="745" width="300" height="120" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Interbank Adapter&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Anti-Corruption Layer]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Sends transfers, receives confirmations (callback with signature check, polling or file)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1860" y="745" width="300" height="120" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Risk and Limits Service&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: microservice, REST]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Limits and fraud rules&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2350" y="465" width="300" height="100" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;manual-operations&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: queue]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Cases a person must resolve&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="495" width="300" height="62" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Transfers DB&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Azure SQL]&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="1230" width="240" height="90" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;transfer-events&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;requested, completed, failed&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="1240" width="230" height="62" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;audit-events&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;every customer action&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="1240" width="230" height="62" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Core Banking Platform&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[External: REST]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Debit, credit, balances&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="1230" width="300" height="100" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Interbank Payment Network&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[External]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Interbank transfers&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1860" y="1230" width="300" height="100" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Security boundaries&lt;/b&gt;&lt;br&gt;1. Internet to gateway: TLS, WAF, JWT validation.&lt;br&gt;2. Gateway to service: mTLS on a private network, identity forwarded in a signed token.&lt;br&gt;3. Service to data and to other systems: private endpoints, managed identity, no secrets in code, timeouts on every call." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="940" width="330" height="170" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Light blue boxes: components (code inside the container). Cylinders: data stores. Dashed blue: asynchronous event. Orange: call to an external system. Yellow band: API layer. Green band: business layer. Blue band: integration and data layer.&lt;br&gt;Bold text in each component gives its name, the line in brackets its technology or pattern." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="2000" height="60" as="geometry"/></mxCell><mxCell id="n30" value="HTTPS, mTLS&lt;br&gt;JWT (scope, acr)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="authorized" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="first request only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n34" value="start saga" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n35" value="limits check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n36" value="REST, mTLS&lt;br&gt;circuit breaker" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#B45F06,#B45F06);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n37" value="on failure or timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="save state (same transaction as outbox)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n39" value="debit, credit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1365" y="640"/><mxPoint x="1545" y="640"/></Array></mxGeometry></mxCell><mxCell id="n40" value="submit, await confirmation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1425" y="690"/><mxPoint x="1920" y="690"/></Array></mxGeometry></mxCell><mxCell id="n41" value="verify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n42" value="settlement report" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1770" y="665"/><mxPoint x="2070" y="665"/></Array></mxGeometry></mxCell><mxCell id="n43" value="manual task" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#0B6BCB,#0B6BCB);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);dashed=1;dashPattern=6 3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n44" value="TransferFailed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#0B6BCB,#0B6BCB);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);dashed=1;dashPattern=6 3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n45" value="poll outbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n46" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#0B6BCB,#0B6BCB);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);dashed=1;dashPattern=6 3;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n17" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n47" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#0B6BCB,#0B6BCB);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);dashed=1;dashPattern=6 3;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n17" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n48" value="SQL, TLS&lt;br&gt;private endpoint" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#8A8A8A,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n49" value="REST, HTTPS&lt;br&gt;timeouts, retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#B45F06,#B45F06);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n50" value="interbank protocol" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#B45F06,#B45F06);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n20" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="Movements Service"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="C4 Level 3 - Components: Movements Service" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Read side of the CQRS design: Cache-Aside, materialized read model and Core fallback, kept current by events." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="Movements Service   [Container: microservice, REST, CQRS query side]" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="1110" height="1010" as="geometry"/></mxCell><mxCell id="n5" value="API layer" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#FFF4D6,#FFF4D6);strokeColor=light-dark(#C9A227,#C9A227);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="170" width="1070" height="190" as="geometry"/></mxCell><mxCell id="n6" value="Query layer" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E6F4EA,#E6F4EA);strokeColor=light-dark(#5BA36F,#5BA36F);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="1070" height="190" as="geometry"/></mxCell><mxCell id="n7" value="Integration and data layer" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E4EEFB,#E4EEFB);strokeColor=light-dark(#5B8FD0,#5B8FD0);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="700" width="1070" height="190" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;API Gateway&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: managed API gateway]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Validated JWT, rate limits&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="300" height="100" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Authorization Filter&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Middleware: JWT claims, scopes]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Scope movements:read; checks the account belongs to the caller (object-level authorization)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Movements API Controller&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[REST: GET /v1/accounts/{id}/movements]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Filters, pagination, returns data with a last-updated timestamp&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Access Event Emitter&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Transactional Outbox]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Publishes CustomerAccessed and audit events (no personal data in the payload)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Cache-Aside Manager&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Cache-Aside, read-through]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Lookup order: cache, then read model, then Core; fills upward, short TTL&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Movements Query Handler&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: CQRS query]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Builds the response, forces refresh when a transfer is about to be made&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Read Model Projector and Cache Warmer&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Event consumer, Idempotent Receiver]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Updates the read model from transfer events; warms cache when a customer becomes frequent&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Cache Client&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Redis client, encrypted, TTL]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Per-customer keys, no secrets cached&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="745" width="300" height="120" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Read Model Repository&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Repository, Cosmos DB]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Partition key is the customer; TTL on documents&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="745" width="300" height="120" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Core Adapter&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Anti-Corruption Layer]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;REST, timeouts, circuit breaker; used when cache and read model miss&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="745" width="300" height="120" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Movements cache&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Redis cache]&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1230" width="240" height="90" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Movements read model&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Cosmos DB]&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1230" width="240" height="90" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Core Banking Platform&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[External: REST]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Movements, balances&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="1230" width="300" height="100" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;customer-access-events&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;who used what&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="200" width="280" height="62" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;audit-events&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;every customer action&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="290" width="280" height="62" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;transfer-events&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;requested, completed, failed&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="440" width="280" height="62" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;frequent-client-events&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;added, removed&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1600" y="540" width="280" height="62" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Why this design&lt;/b&gt;&lt;br&gt;Reads dominate traffic. Frequent customers are served from a nearby cache and a durable read model, which cuts Core calls and keeps history visible if the Core is slow.&lt;br&gt;The Core stays the source of truth: balances show a last-updated time and are refreshed before money moves." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="940" width="330" height="200" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Light blue boxes: components (code inside the container). Cylinders: data stores. Dashed blue: asynchronous event. Orange: call to an external system. Yellow band: API layer. Green band: business layer. Blue band: integration and data layer.&lt;br&gt;Bold text in each component gives its name, the line in brackets its technology or pattern." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="2000" height="60" as="geometry"/></mxCell><mxCell id="n27" value="HTTPS, mTLS&lt;br&gt;JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="authorized" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="records access" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="get movements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="1. cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="2. read model" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="655"/><mxPoint x="860" y="655"/></Array></mxGeometry></mxCell><mxCell id="n34" value="3. Core (fallback)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="705" y="675"/><mxPoint x="1210" y="675"/></Array></mxGeometry></mxCell><mxCell id="n35" value="update read model" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1210" y="640"/><mxPoint x="1010" y="640"/></Array></mxGeometry></mxCell><mxCell id="n36" value="Redis protocol, TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#8A8A8A,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n3