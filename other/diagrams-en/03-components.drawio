style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#0B6BCB,#0B6BCB);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);dashed=1;dashPattern=6 3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1540" y="471"/><mxPoint x="1540" y="495"/></Array></mxGeometry></mxCell><mxCell id="n42" value="subscribes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#0B6BCB,#0B6BCB);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);dashed=1;dashPattern=6 3;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n24" target="n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1555" y="571"/><mxPoint x="1555" y="555"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="Frequent Client Service"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="C4 Level 3 - Components: Frequent Client Service" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Event-driven classification. It only reads activity events and announces changes; other services decide how to use them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="Frequent Client Service   [Container: microservice]" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="760" height="1010" as="geometry"/></mxCell><mxCell id="n5" value="Event layer" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#FFF4D6,#FFF4D6);strokeColor=light-dark(#C9A227,#C9A227);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="170" width="720" height="190" as="geometry"/></mxCell><mxCell id="n6" value="Classification layer" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E6F4EA,#E6F4EA);strokeColor=light-dark(#5BA36F,#5BA36F);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="720" height="190" as="geometry"/></mxCell><mxCell id="n7" value="Data and events" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E4EEFB,#E4EEFB);strokeColor=light-dark(#5B8FD0,#5B8FD0);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="700" width="720" height="190" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;customer-access-events&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;who used what&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="290" height="62" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;frequent-client-events&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;added, removed&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1240" y="774" width="290" height="62" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Activity Event Consumer&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Service Bus subscriber, Idempotent Receiver]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Reads CustomerAccessed and transfer events; dead-letters poison messages&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Frequency Scorer&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Rolling-window score]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Counts activity per customer in a sliding window&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Classification Rules&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Configurable rule, feature flag]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Threshold for what counts as frequent, changeable without release&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Counters Repository&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Redis client]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Activity counters with expiry&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="745" width="300" height="120" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Classification Publisher&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Transactional Outbox]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Publishes FrequentClientAdded and FrequentClientRemoved&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="745" width="300" height="120" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Activity counters&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Redis cache]&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1230" width="240" height="90" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Light blue boxes: components (code inside the container). Cylinders: data stores. Dashed blue: asynchronous event. Orange: call to an external system. Yellow band: API layer. Green band: business layer. Blue band: integration and data layer.&lt;br&gt;Bold text in each component gives its name, the line in brackets its technology or pattern." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="2000" height="60" as="geometry"/></mxCell><mxCell id="n17" value="subscribes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#0B6BCB,#0B6BCB);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);dashed=1;dashPattern=6 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="activity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="apply rule" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="increment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="changed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="Redis protocol, TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#8A8A8A,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#0B6BCB,#0B6BCB);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);dashed=1;dashPattern=6 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="Onboarding Service"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="C4 Level 3 - Components: Onboarding Service" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Identity proofing gate. Vendor and registry results are never trusted from the app; they arrive through authenticated back-channel calls and drive a state machine." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="Onboarding Service   [Container: microservice, REST]" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="1820" height="1050" as="geometry"/></mxCell><mxCell id="n5" value="API layer: identity, attestation, webhook authentication" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#FFF4D6,#FFF4D6);strokeColor=light-dark(#C9A227,#C9A227);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="170" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n6" value="Business layer: onboarding state machine and decisions" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E6F4EA,#E6F4EA);strokeColor=light-dark(#5BA36F,#5BA36F);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n7" value="Integration and data layer: adapters, IdP provisioning, repository" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E4EEFB,#E4EEFB);strokeColor=light-dark(#5B8FD0,#5B8FD0);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="700" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;API Gateway&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: managed API gateway]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Mobile app and back-office calls&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="300" height="100" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Authorization Filter&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Middleware: JWT, scopes, roles]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Mobile scope onboarding; staff role for manual review&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Onboarding API Controller&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[REST: start session, submit data, get status]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Called by the mobile app; returns only safe status messages&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Manual Review API&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[REST, staff role, four-eyes rule]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Lists queued cases, records the reviewer decision&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Vendor Webhook Endpoint&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[HTTPS, HMAC signature, timestamp, replay protection]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Receives the verification result; never trusts the app&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Device Attestation Verifier&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Play Integrity, App Attest]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Rejects emulators and tampered apps before capture starts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Onboarding Orchestrator&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: state machine]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;STARTED, CAPTURED, LIVENESS_PASSED, SCREENING, APPROVED, UNDER_REVIEW, REJECTED, ACTIVE; records consent and accepted terms&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="465" width="300" height="140" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Decision Engine&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Risk-based rules]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Combines vendor score, registry match, screening result: approve, review or reject&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Identity Vendor Adapter&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Anti-Corruption Layer]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Creates verification sessions, fetches results if a webhook is lost; vendor is swappable&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Civil Registry Adapter&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Anti-Corruption Layer]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Validates ID data, photo and fingerprint code&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Screening Adapter&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Pattern: Anti-Corruption Layer]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Sanctions and PEP checks, duplicate identity check&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;IdP Provisioning Client&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[OAuth client credentials, admin API]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Creates the user with kyc_level verified after approval&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;Onboarding Repository and Outbox&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Patterns: Repository, Transactional Outbox]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Saves case state and events in one transaction; relay publishes them&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1860" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Identity Verification Service&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[External]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Document, liveness, face match&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1290" width="300" height="90" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;National Civil Registry&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[External]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;ID data, photo, fingerprint code&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="1290" width="300" height="90" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Compliance Screening Service&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[External]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Sanctions and PEP lists&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="1290" width="300" height="90" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;BP Authorization Server&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[External: OAuth 2.0]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;User store and login&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="1290" width="300" height="90" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Onboarding DB&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Azure SQL]&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="1890" y="1285" width="240" height="90" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;onboarding-events&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;completed, rejected&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="745" width="280" height="62" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;audit-events&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Container: topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;every customer action&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2300" y="860" width="280" height="62" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Fingerprint code and face&lt;/b&gt;&lt;br&gt;The selfie is compared with the ID photo and with reference data from the registry. The fingerprint code is captured and compared with the code entered. Raw images stay with the vendor for the shortest legal period." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="940" width="330" height="200" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Light blue boxes: components (code inside the container). Cylinders: data stores. Dashed blue: asynchronous event. Orange: call to an external system. Yellow band: API layer. Green band: business layer. Blue band: integration and data layer.&lt;br&gt;Bold text in each component gives its name, the line in brackets its technology or pattern." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="1450" width="2000" height="60" as="geometry"/></mxCell><mxCell id="n30" value="HTTPS, mTLS&lt;br&gt;JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="mobile" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="staff" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="203"/><mxPoint x="1290" y="203"/></Array></mxGeometry></mxCell><mxCell id="n33" value="start, submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n34" value="verify device" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n35" value="reviewer decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n36" value="verification result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n37" value="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="create session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.08;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="804.0" y="660"/><mxPoint x="570.0" y="660"/></Array></mxGeometry></mxCell><mxCell id="n39" value="save, publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.92;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n20"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1056.0" y="660"/><mxPoint x="2010.0" y="660"/></Array></mxGeometry></mxCell><mxCell id="n40" value="provision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.8200000000000001;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1026.0" y="676"/><mxPoint x="1650.0" y="676"/></Array></mxGeometry></mxCell><mxCell id="n41" value="screen" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.72;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="996.0" y="692"/><mxPoint x="1290.0" y="692"/></Array></mxGeometry></mxCell><mxCell id="n42" value="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n43" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#B45F06,#B45F06);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n44" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#B45F06,#B45F06);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent=