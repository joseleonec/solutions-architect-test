                <mxCell id="n2" value="C4 Dynamic diagram 2: Onboarding a new customer with face and document verification" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" parent="1" vertex="1">
