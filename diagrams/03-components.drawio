n49" value="publica" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#0B6BCB,#0B6BCB);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);dashed=1;dashPattern=6 3;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n20" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="Notification Service"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="C4 Nivel 3 - Componentes: Servicio de Notificaciones" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Notificaciones regulatorias por al menos dos canales, con conmutación de proveedor. Patrones: Idempotent Receiver, Strategy con cadena de respaldo, Circuit Breaker por proveedor, Dead-Letter Queue." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="Servicio de Notificaciones   [Contenedor: microservicio]" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="1820" height="1050" as="geometry"/></mxCell><mxCell id="n5" value="Capa de eventos" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#FFF4D6,#FFF4D6);strokeColor=light-dark(#C9A227,#C9A227);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="170" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n6" value="Capa de negocio: decidir, renderizar, enrutar, dar seguimiento" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E6F4EA,#E6F4EA);strokeColor=light-dark(#5BA36F,#5BA36F);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n7" value="Adaptadores de canal y datos" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E4EEFB,#E4EEFB);strokeColor=light-dark(#5B8FD0,#5B8FD0);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="700" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;eventos-transferencia&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Contenedor: Azure Service Bus, topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;solicitada, completada, fallida&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="300" height="62" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;eventos-onboarding&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Contenedor: Azure Service Bus, topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;completado, rechazado&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="265" width="300" height="62" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Consumidor de eventos&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Suscriptor de Service Bus, receptor idempotente]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Deduplica por ID de evento para que un evento reentregado nunca envíe una segunda alerta&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Resolutor de preferencias&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Reglas por tipo de evento]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Qué canales y qué contenido, según las preferencias del cliente y las reglas del producto&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Generador de plantillas&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Plantillas localizadas]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Enmascara datos: últimos 4 dígitos, monto, hora; nunca números de cuenta completos ni secretos&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Enrutador de canales&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Patrón: Strategy, cadena de respaldo]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Primero SMS (proveedor secundario si falla), luego correo si la entrega no se confirma a tiempo&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Seguimiento de entregas&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Máquina de estados, reintentos]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Registra enviado, entregado, fallido; anota cada intento&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Manejador de mensajes fallidos&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Patrón: cola de mensajes fallidos (Dead-Letter Queue)]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Tras los reintentos máximos, aparta el mensaje y avisa a operaciones&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1860" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Adaptador SMS, principal&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Corte de circuito (Circuit Breaker) por proveedor]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Envía SMS; abre el circuito ante fallas repetidas&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Adaptador SMS, secundario&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Corte de circuito (Circuit Breaker) por proveedor]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Toma el relevo cuando falla el proveedor principal&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Adaptador de correo&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Capa anticorrupción]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Envía la copia por correo que sirve de constancia; aquí se puede agregar después un adaptador de push&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Repositorio de notificaciones y outbox&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Patrones: repositorio, outbox transaccional]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Preferencias, plantillas, registro de entregas; publica NotificationSent como evento de auditoría&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1860" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Proveedor SMS A&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;SMS principal&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1290" width="300" height="90" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Proveedor SMS B&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;SMS secundario&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="1290" widt