;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Auditoría inmutable y a prueba de alteraciones, escrita de forma asíncrona, leída solo mediante una API de consulta auditada, con una tarea de reportes de cumplimiento." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="Servicio de Auditoría   [Contenedor: microservicio, REST]" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="1820" height="1050" as="geometry"/></mxCell><mxCell id="n5" value="Puntos de entrada" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#FFF4D6,#FFF4D6);strokeColor=light-dark(#C9A227,#C9A227);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="170" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n6" value="Capa de negocio: validar, archivar, reportar, consultar" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E6F4EA,#E6F4EA);strokeColor=light-dark(#5BA36F,#5BA36F);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n7" value="Capa de integración y datos" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=light-dark(#E4EEFB,#E4EEFB);strokeColor=light-dark(#5B8FD0,#5B8FD0);opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#333333);fontSize=12;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="700" width="1780" height="190" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;eventos-auditoria&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Contenedor: Azure Service Bus, topic]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;cada acción del cliente&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=30;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="300" height="62" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;API Gateway&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Contenedor: API gateway administrado]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Llamadas del personal, JWT con rol de auditoría&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2350" y="205" width="300" height="100" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Consumidor de eventos de auditoría&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Suscriptor de Service Bus, receptor idempotente]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Lee eventos de auditoría; aparta los mal formados&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;API de consulta de auditoría&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[REST, solo lectura, acceso por roles]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Búsqueda por cliente, fecha, ID de correlación; cada consulta queda auditada&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1860" y="215" width="300" height="120" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Validador y enriquecedor de eventos&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Validación de esquema, cadena de hashes]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Verifica el esquema, agrega la marca de tiempo y enlaza cada registro con el hash anterior&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Escritor de archivo y resúmenes&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Patrón: archivo de solo anexar]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Escribe en almacenamiento inmutable y guarda por separado resúmenes diarios de hashes&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Generador de reportes de cumplimiento&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Tarea programada, reglas]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Marca casos por umbral y por patrón y prepara reportes para las autoridades&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Manejador de consultas de auditoría&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Patrón: consulta CQRS]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Lee el libro mayor; enmascara campos sensibles según el rol&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1860" y="465" width="300" height="120" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Escritor del libro mayor&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Patrón: repositorio, solo anexar]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Inserta en tablas de libro mayor SQL; en el código no existen actualizaciones ni borrados&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Cliente de archivo&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[SDK de Blob Storage]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Política de retención inmutable (WORM)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Adaptador de entrega de reportes&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Patrón: capa anticorrupción]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Entrega segura por archivo o API a las autoridades regulatorias&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1500" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Lector del libro mayor&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Patrón: repositorio, solo lectura]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Identidad de base de datos de solo lectura&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1860" y="765" width="300" height="120" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Archivo de auditoría&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Blob Storage, inmutable]&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="1285" width="240" height="90" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Libro mayor de auditoría&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Tablas de libro mayor de Azure SQL]&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="1285" width="240" height="90" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Autoridades regulatorias&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Reportes obligatorios&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="1290" width="300" height="90" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Separación de funciones&lt;/b&gt;&lt;br&gt;La identidad de escritura solo puede insertar. La identidad de lectura solo puede leer. El personal de operaciones no puede alterar registros." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="940" width="330" height="150" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Cajas azul claro: componentes (código dentro del contenedor). Cilindros: almacenes de datos. Azul punteado: evento asíncrono. Naranja: llamada a un sistema externo. Franja amarilla: capa API. Franja verde: capa de negocio. Franja azul: capa de integración y datos.&lt;br&gt;El texto en negrita de cada componente es su nombre; la línea entre corchetes, su tecnología o patrón." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="1450" width="2000" height="60" as="geometry"/></mxCell><mxCell id="n25" value="se suscribe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#0B6BCB,#0B6BCB);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);dashed=1;dashPattern=6 3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="HTTPS, mTLS&lt;br&gt;JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n27" value="evento" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="también archiva" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="anexa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="escribe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n31" value="consulta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n32" value="lee" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="reporte" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n34" value="lee" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1770" y="660"/><mxPoint x="1920" y="660"/></Array></mxGeometry></mxCell><mxCell id="n35" value="SQL, TLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#8A8A8A,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n21"><mxGeometry x="0.7" relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="1100"/><mxPoint x="1290" y="1100"/></Array></mxGeometry></mxCell><mxCell id="n36" value="SQL, TLS, solo lectura" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#8A8A8A,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2010" y="1125"/><mxPoint x="1290" y="1125"/></Array></mxGeometry></mxCell><mxCell id="n37" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#8A8A8A,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n17" target="n20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="archivo seguro o API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#B45F06,#B45F06);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="Web BFF"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="C4 Nivel 3 - Componentes: Web BFF (Backend for Frontend)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Mantiene los tokens en el servidor. El navegador solo guarda una cookie de sesión, así que un script malicioso de la página no puede robar tokens." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Angular SPA&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Contenedor: navegador]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Solo guarda una cookie de sesión, sin tokens&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="110" width="300" height="100" as="geometry"/></mxCell><mxCell id="n5" value="Web BFF   [Contenedor: Backend for Frontend, REST]" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="1320" height="530" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Almacén de sesiones&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Caché Redis, cifrada]&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="350" width="260" height="90" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Protección CSRF&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Cookie SameSite + encabezado anti-falsificación]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Rechaza llamadas que cambian datos sin el encabezado&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="490" width="260" height="120" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Administrador de sesión&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Cookie HttpOnly, Secure, SameSite=Strict]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Tiempos de inactividad y absolutos; sesión en el servidor&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="490" width="260" height="120" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Cliente OIDC&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Authorization Code + PKCE, PAR, private_key_jwt]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Ejecuta el inicio de sesión; cliente confidencial&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="490" width="260" height="120" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Cliente de API&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Generado a partir de OpenAPI]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Agrega el token de acceso, el ID de correlación y la clave de idempotencia&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="680" width="260" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Servicio de agregación&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Llamadas en paralelo, una respuesta por pantalla]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Combina las llamadas de perfil, saldos y movimientos&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="680" width="260" height="120" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Renovador de tokens&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Rotación del refresh token]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Renueva tokens; revoca la sesión si detecta reutilización&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="680" width="260" height="120" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Servidor de autorización de BP&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Externo: OAuth 2.0 / OIDC]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Endpoint de tokens&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1780" y="485" width="300" height="130" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;API Gateway&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Contenedor: API gateway administrado]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Valida el token del usuario y enruta la llamada&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="1000" width="300" height="110" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Cajas azul claro: componentes (código dentro del contenedor). Cilindros: almacenes de datos. Azul punteado: evento asíncrono. Naranja: llamada a un sistema externo. Franja amarilla: capa API. Franja verde: capa de negocio. Franja azul: capa de integración y datos.&lt;br&gt;El texto en negrita de cada componente es su nombre; la línea entre corchetes, su tecnología o patrón." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="1190" width="2000" height="60" as="geometry"/></mxCell><mxCell id="n16" value="Llamadas a la API web&lt;br&gt;HTTPS, cookie de sesión" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n7"><mxGeometry x="-0.5" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n17" value="solicitud válida" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="sin sesión: iniciar sesión" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="sesión" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#8A8A8A,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="sesión con tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="llama" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="intercambio del código, OIDC + PKCE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#2E7D32,#2E7D32);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="HTTPS, mTLS&lt;br&gt;token del usuario" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="API Gateway"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="C4 Nivel 3 - Componentes: API Gateway (cadena de políticas)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Toda solicitud pasa por las mismas verificaciones, en orden, antes de llegar a un servicio. Las solicitudes que fallan un paso se rechazan aquí." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2200" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;App móvil&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Contenedor: Flutter]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Guarda los tokens en Keychain / Keystore&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="300" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Portal de back-office&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Contenedor: aplicación web Angular]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Llamadas del personal con token SSO&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="300" height="100" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Web BFF&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Contenedor: Backend for Frontend]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Agrega el token de acceso del usuario&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="110" width="300" height="100" as="geometry"/></mxCell><mxCell id="n7" value="API Gateway   [Contenedor: API gateway administrado]" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="330" width="2080" height="300" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;1. Validación de JWT&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Política del gateway]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Firma con JWKS en caché, emisor, audiencia, vencimiento&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;2. Verificación de alcance y nivel de aseguramiento&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Política del gateway]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Alcance por API; acr para el paso adicional en llamadas sensibles&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="695" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;3. Límites de tasa y cuotas&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Política del gateway]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Por cliente, por usuario, por IP&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;4. Validación de esquema&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Política del gateway]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Solicitud verificada contra el contrato OpenAPI&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1285" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;5. Correlación y registro&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Política del gateway]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Contexto de traza W3C, registros enmascarados&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1580" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;6. Enrutamiento y versionado&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Política del gateway]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Enrutamiento por ruta, /v1, canary&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1875" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;7. mTLS hacia los servicios&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;[Política del gateway]&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;Certificado de cliente hacia los servicios, red privada&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#85BBF0,#85BBF0);strokeColor=light-dark(#5D82A8,#5D82A8);fontColor=light-dark(#000000,#000000);arcSize=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2170" y="400" width="270" height="150" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Servidor de autorización de BP&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Externo: OAuth 2.0 / OIDC]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Llaves de firma (JWKS)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="780" width="300" height="100" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Servicios de back-end&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Contenedores: microservicios]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Perfil, Movimientos, Transferencias, Onboarding, Notificaciones, Auditoría&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1700" y="780" width="760" height="100" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Límites de seguridad&lt;/b&gt;&lt;br&gt;Llamadores hacia el gateway: TLS, tokens, certificate pinning en el móvil. Gateway hacia los servicios: mTLS en una red privada. La protección del borde (WAF, DDoS) está delante del gateway y se muestra en el diagrama de despliegue." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="900" y="760" width="700" height="120" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Cajas azul claro: componentes (código dentro del contenedor). Cilindros: almacenes de datos. Azul punteado: evento asíncrono. Naranja: llamada a un sistema externo. Franja amarilla: capa API. Franja verde: capa de negocio. Franja azul: capa de integración y datos.&lt;br&gt;El texto en negrita de cada componente es su nombre; la línea entre corchetes, su tecnología o patrón." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="980" width="2000" height="60" as="geometry"/></mxCell><mxCell id="n19" value="Llamadas de la app móvil&lt;br&gt;HTTPS, TLS 1.2+" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.26;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n8"><mxGeometry x="-0.2" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="Token del usuario&lt;br&gt;HTTPS, mTLS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n8"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="300"/><mxPoint x="630" y="300"/></Array></mxGeometry></mxCell><mxCell id="n21" value="Llamadas del personal&lt;br&gt;HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n8"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="285"/><mxPoint x="562" y="285"/></Array></mxGeometry></mxCell><mxCell id="n22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="llaves de firma, en caché" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#2E7D32,#2E7D32);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);dashed=1;dashPattern=6 3;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n15" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="solicitud enrutada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n14" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>