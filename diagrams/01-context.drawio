<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="p1" name="C4 L1 - System Context"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="C4 Nivel 1 - Contexto del sistema: BP Internet Banking" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Quién usa el sistema, en qué sistemas internos se apoya y con qué servicios externos se conecta. Sin detalle de tecnología." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1500" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Cliente&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Persona]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Cliente actual de BP. Consulta saldos y movimientos, hace transferencias y pagos desde la web o el celular.&lt;/font&gt;&lt;/div&gt;" style="html=1;dashed=0;whiteSpace=wrap;fillColor=light-dark(#08427b,#08427b);strokeColor=light-dark(#073B6F,#073B6F);fontColor=light-dark(#ffffff,#ffffff);shape=mxgraph.c4.person2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="556.0" y="110" width="200" height="180" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Cliente potencial&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Persona]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Persona que quiere ser cliente y abre una cuenta desde la app móvil.&lt;/font&gt;&lt;/div&gt;" style="html=1;dashed=0;whiteSpace=wrap;fillColor=light-dark(#08427b,#08427b);strokeColor=light-dark(#073B6F,#073B6F);fontColor=light-dark(#ffffff,#ffffff);shape=mxgraph.c4.person2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780.0" y="110" width="200" height="180" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Personal de operaciones y cumplimiento de BP&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Persona]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Revisa onboardings dudosos e investiga actividad con la auditoría.&lt;/font&gt;&lt;/div&gt;" style="html=1;dashed=0;whiteSpace=wrap;fillColor=light-dark(#08427b,#08427b);strokeColor=light-dark(#073B6F,#073B6F);fontColor=light-dark(#ffffff,#ffffff);shape=mxgraph.c4.person2;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1004.0" y="110" width="200" height="180" as="geometry"/></mxCell><mxCell id="n7" value="Banco BP (sistemas internos)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="50" y="340" width="1170" height="800" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;BP Internet Banking&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema de software]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:12px;text-align:left;padding:0 40px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Aplicación web y móvil para los clientes de BP.&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Qué hace&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&amp;bull; Muestra los movimientos y el historial de las cuentas&lt;br&gt;&amp;bull; Transferencias y pagos entre cuentas propias&lt;br&gt;&amp;bull; Transferencias y pagos a otros bancos&lt;br&gt;&amp;bull; Abre cuentas a clientes nuevos con cédula y verificación del rostro&lt;br&gt;&amp;bull; Envía un aviso por cada movimiento (SMS y correo)&lt;br&gt;&amp;bull; Registra cada acción en una auditoría a prueba de alteraciones&lt;br&gt;&amp;bull; Sigue disponible y se recupera solo si fallan partes&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#1168BD,#1168BD);strokeColor=light-dark(#0B4884,#0B4884);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="400" width="560" height="700" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Plataforma Core bancaria&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema de software]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Sistema de registro: datos básicos del cliente, productos, cuentas y movimientos.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="445.0" width="270" height="120" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Sistema de detalle del cliente&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema de software]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Sistema independiente con la información adicional y detallada del cliente.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="690.0" width="270" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Servidor de autorización de BP&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema de software]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Servicio de inicio de sesión corporativo. Confirma quién es el usuario y con qué fuerza lo demostró.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="935.0" width="270" height="120" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Servicio de verificación de identidad&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Comprueba que la persona es real (selfie en vivo) y coincide con el documento de identidad.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="413.3333333333333" width="340" height="90" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Registro Civil nacional&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Valida los datos de la cédula, su foto y el código dactilar.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="530.0" width="340" height="90" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Servicio de screening de cumplimiento&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Revisa listas de sanciones y de riesgo (prevención de lavado de activos).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="646.6666666666667" width="340" height="90" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Red de pagos interbancarios&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Mueve dinero entre BP y otros bancos.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="763.3333333333334" width="340" height="90" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Proveedores de SMS y correo&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Envían avisos de movimientos por SMS y correo (dos proveedores de SMS).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="880.0" width="340" height="90" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Autoridades regulatorias&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Reciben los reportes obligatorios (por ejemplo, de prevención de lavado de activos).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="996.6666666666665" width="340" height="90" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Azul oscuro: personas. Azul: sistemas de BP. Gris violeta: sistemas externos. Marco punteado: límite de BP.&lt;br&gt;Cada flecha muestra quién le pide algo a quién; la etiqueta dice para qué." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="50" y="1170" width="900" height="60" as="geometry"/></mxCell><mxCell id="n19" value="Consulta saldos y movimientos,&lt;br&gt;hace transferencias y pagos" style="edgeStyle=none;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#707070,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="Abre una cuenta con&lt;br&gt;la foto de la cédula y un selfie" style="edgeStyle=none;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#707070,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="Revisa onboardings dudosos,&lt;br&gt;lee la auditoría" style="edgeStyle=none;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#707070,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="Lee datos del cliente, productos&lt;br&gt;y movimientos; registra transferencias" style="edgeStyle=none;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#707070,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0;exitY=0.15;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n23" value="Lee información&lt;br&gt;detallada del cliente" style="edgeStyle=none;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#707070,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n24" value="Inicia la sesión de los usuarios y verifica&lt;br&gt;cómo demostraron quiénes son" style="edgeStyle=none;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#707070,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="Envía el documento de identidad y el selfie en vivo&lt;br&gt;para su verificación" style="edgeStyle=none;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#707070,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.08333333333333333;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n26" value="Valida los datos de la cédula, la foto&lt;br&gt;y el código dactilar" style="edgeStyle=none;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#707070,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n27" value="Revisa a los clientes nuevos&lt;br&gt;contra listas de riesgo" style="edgeStyle=none;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#707070,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.4166666666666667;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n28" value="Envía transferencias a otros bancos&lt;br&gt;y recibe confirmaciones" style="edgeStyle=none;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#707070,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5833333333333334;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n29" value="Envía avisos de movimientos&lt;br&gt;(SMS y correo)" style="edgeStyle=none;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#707070,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n30" value="Envía reportes obligatorios" style="edgeStyle=none;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#707070,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.9166666666666666;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>