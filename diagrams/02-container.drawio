=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1700" width="250" height="90" as="geometry"/></mxCell><mxCell id="n41" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Servicio de verificación de identidad&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Documento, prueba de vida, coincidencia facial&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2000" y="1013" width="300" height="84" as="geometry"/></mxCell><mxCell id="n42" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Registro Civil nacional&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Datos de la cédula, foto, código dactilar&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2000" y="1113" width="300" height="84" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Servicio de screening de cumplimiento&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Listas de sanciones y PEP&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2000" y="1213" width="300" height="84" as="geometry"/></mxCell><mxCell id="n44" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Servidor de autorización de BP&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Externo: sistema de BP, OAuth 2.0 / OIDC]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Servicio de inicio de sesión corporativo&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2000" y="1313" width="300" height="90" as="geometry"/></mxCell><mxCell id="n45" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Proveedores de SMS y correo (2)&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;SMS principal y secundario, correo&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2000" y="1436" width="300" height="80" as="geometry"/></mxCell><mxCell id="n46" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Autoridades regulatorias&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistema externo]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Reportes obligatorios&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2000" y="1790" width="300" height="84" as="geometry"/></mxCell><mxCell id="n47" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Gris continuo: solicitud síncrona. Azul punteado: evento asíncrono (flecha hacia un tema = publica, flecha desde un tema = se suscribe). Naranja: llamada a un sistema externo. Verde: autenticación.&lt;br&gt;Cilindros: almacenes de datos, cada uno de un solo servicio (base de datos por servicio). Cápsulas azules redondeadas: temas de mensajería. Todos los servicios usan además los secretos, el monitoreo y la seguridad de la plataforma (ver diagrama de despliegue).&lt;br&gt;Todos los servicios publican eventos de auditoría en eventos-auditoria; solo se dibujan los principales para mantener el diagrama legible: Perfil, Movimientos, Transferencias, Onboarding y Notificaciones." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="60" y="2060" width="2100" height="80" as="geometry"/></mxCell><mxCell id="n48" value="Usa" style="edgeStyle=none;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1"