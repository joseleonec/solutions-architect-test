ontSize=10;" vertex="1" parent="1"><mxGeometry x="2031" y="600" width="150" height="60" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Onboarding x1&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2193" y="600" width="150" height="60" as="geometry"/></mxCell><mxCell id="n44" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Notificaciones x1&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1545" y="680" width="150" height="60" as="geometry"/></mxCell><mxCell id="n45" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Auditoría x1&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1707" y="680" width="150" height="60" as="geometry"/></mxCell><mxCell id="n46" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Cliente frecuente x1&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1869" y="680" width="150" height="60" as="geometry"/></mxCell><mxCell id="n47" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Riesgo y Límites x1&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="2031" y="680" width="150" height="60" as="geometry"/></mxCell><mxCell id="n48" value="Contenedores desplegados aquí: Web BFF y los ocho microservicios, repartidos entre zonas con anti-afinidad de pods" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="1545" y="760" width="800" height="24" as="geometry"/></mxCell><mxCell id="n49" value="&lt;b&gt;Datos y mensajería&lt;/b&gt; &lt;span style=&quot;font-size:10px&quot;&gt;(endpoints privados, identidad administrada, cifrado con llaves administradas por el banco)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#FFFFFF);strokeColor=light-dark(#5F6B7A,#5F6B7A);strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;fontSize=11;fontColor=light-dark(#1a1a1a,#1a1a1a);" vertex="1" parent="1"><mxGeometry x="1530" y="840" width="840" height="590" as="geometry"/></mxCell><mxCell id="n50" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure SQL Database&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Secundario geográfico en un grupo de conmutación&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="1560" y="890" width="780" height="72" as="geometry"/></mxCell><mxCell id="n51" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure Cosmos DB&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Región réplica&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="1560" y="978" width="780" height="72" as="geometry"/></mxCell><mxCell id="n52" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure Cache for Redis Premium&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Réplica geográfica&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="1560" y="1066" width="780" height="72" as="geometry"/></mxCell><mxCell id="n53" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure Service Bus Premium&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Namespace secundario (recuperación geográfica ante desastres)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1560" y="1154" width="780" height="72" as="geometry"/></mxCell><mxCell id="n54" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure Blob Storage&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Secundario GZRS, se mantiene la inmutabilidad&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="1560" y="1242" width="780" height="72" as="geometry"/></mxCell><mxCell id="n55" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Key Vault y Managed HSM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Segundo pool de HSM, respaldo y restauración de llaves&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1560" y="1330" width="780" height="72" as="geometry"/></mxCell><mxCell id="n56" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure Monitor, Log Analytics, Defender for Cloud, Sentinel&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Nodo de despliegue: observabilidad y seguridad]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Espacio de trabajo local; las alertas continúan si se pierde la región primaria&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1530" y="1470" width="840" height="100" as="geometry"/></mxCell><mxCell id="n57" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Proveedores externos&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Sistemas externos]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Verificación de identidad, registro civil, screening de cumplimiento, proveedores de SMS y correo, red de pagos interbancarios, reguladores. Se accede por HTTPS o enlaces dedicados con direcciones de salida autorizadas.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#8C8496,#8C8496);strokeColor=light-dark(#736782,#736782);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2500" y="540" width="360" height="200" as="geometry"/></mxCell><mxCell id="n58" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Cajas blancas: nodos de despliegue (infraestructura). Cajas azules: contenedores desplegados en un nodo. Azul intenso: servicios administrados de Azure. Gris continuo: tráfico de solicitudes. Morado punteado: replicación o conmutación. Naranja: enlace privado con el centro de datos de BP.&lt;br&gt;Supuestos: solo producción (los entornos no productivos siguen el mismo esquema en menor tamaño); el Core y el sistema de detalle están en un centro de datos propio, alcanzables por ExpressRoute con VPN de respaldo; las cantidades de instancias son ilustrativas." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="1660" width="2600" height="60" as="geometry"/></mxCell><mxCell id="n59" value="HTTPS, TLS 1.2+" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dark(#666666,#BDBDBD);strokeWidth=1;fontSize=10;fontColor=light-dark(#222222,#EEEEEE);labelBackgroundColor=light-dark(#FFFFFF,#2B2B2B);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n60" value="HTTPS, TLS 1.2+, certificate pinning" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=light-dar