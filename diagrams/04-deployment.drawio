<mxfile host="app.diagrams.net" agent="claude" version="24.0.0"><diagram id="p1" name="C4 Deployment - Production"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2900" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Diagrama de despliegue C4: BP Internet Banking (producción, región primaria y recuperación ante desastres)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=light-dark(#1a1a1a,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2200" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Dónde se ejecutan los contenedores. La región primaria es zona-redundante y atiende el tráfico; la región de DR pareja es una espera en caliente que recibe replicación continua. Las cantidades de instancias son supuestos de dimensionamiento para un banco mediano." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="40" y="64" width="2600" height="24" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Navegador web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Portátil o computadora de escritorio&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#FFFFFF);strokeColor=light-dark(#5F6B7A,#5F6B7A);strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;fontSize=11;fontColor=light-dark(#1a1a1a,#1a1a1a);" vertex="1" parent="1"><mxGeometry x="40" y="110" width="320" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Angular SPA&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="280" height="44" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Teléfono móvil&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;iOS o Android&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#FFFFFF);strokeColor=light-dark(#5F6B7A,#5F6B7A);strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;fontSize=11;fontColor=light-dark(#1a1a1a,#1a1a1a);" vertex="1" parent="1"><mxGeometry x="40" y="240" width="320" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;App móvil Flutter&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="280" height="44" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure Front Door Premium&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Borde global, nodo de despliegue]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;WAF (reglas OWASP, bots), protección DDoS, TLS 1.2+, pruebas de salud, enrutamiento por prioridad con conmutación automática a la región de DR&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="110" width="760" height="120" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Sitio estático de Azure Storage&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Nodo de despliegue detrás de Front Door]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Archivos de la Angular SPA y del Portal de back-office, servidos desde la caché del borde (CDN)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="110" width="460" height="120" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Centro de datos de BP (se asume propio)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;La ubicación del Core es un supuesto por confirmar&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#FFFFFF);strokeColor=light-dark(#5F6B7A,#5F6B7A);strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;fontSize=11;fontColor=light-dark(#1a1a1a,#1a1a1a);" vertex="1" parent="1"><mxGeometry x="40" y="480" width="400" height="470" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Plataforma Core bancaria&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Externo: sistema de BP]&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="360" height="70" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Sistema de detalle del cliente&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Externo: sistema de BP]&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="360" height="70" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Servidor de autorización de BP&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Externo: sistema de BP]&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="360" height="70" as="geometry"/></mxCell><mxCell id="n14" value="El servidor de autorización también puede estar en la nube; el diseño solo necesita que sea alcanzable por el enlace privado y esté altamente disponible." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="60" y="820" width="360" height="100" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Región de Azure: South Central US (primaria)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Atiende el tráfico de producción; tres zonas de disponibilidad&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="500" y="330" width="900" height="1290" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;API Management Premium&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Nodo de despliegue: API gateway, 2 unidades, zona-redundante]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Contenedor API Gateway: validación de JWT, alcances, límites de tasa, enrutamiento&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="400" width="840" height="100" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;Clúster de Azure Kubernetes Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;3 zonas de disponibilidad, grupos de nodos de sistema y de usuario, autoescalado, reparación automática de nodos&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#FFFFFF);strokeColor=light-dark(#5F6B7A,#5F6B7A);strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;fontSize=11;fontColor=light-dark(#1a1a1a,#1a1a1a);" vertex="1" parent="1"><mxGeometry x="530" y="540" width="840" height="250" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Web BFF x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="600" width="150" height="60" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Perfil x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="707" y="600" width="150" height="60" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Movimientos x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="869" y="600" width="150" height="60" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Transferencias x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1031" y="600" width="150" height="60" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Onboarding x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1193" y="600" width="150" height="60" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Notificaciones x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="545" y="680" width="150" height="60" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Auditoría x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="707" y="680" width="150" height="60" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Cliente frecuente x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="869" y="680" width="150" height="60" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Riesgo y Límites x3&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);arcSize=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1031" y="680" width="150" height="60" as="geometry"/></mxCell><mxCell id="n27" value="Contenedores desplegados aquí: Web BFF y los ocho microservicios, repartidos entre zonas con anti-afinidad de pods" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=light-dark(#333333,#EAEAEA);" vertex="1" parent="1"><mxGeometry x="545" y="760" width="800" height="24" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Datos y mensajería&lt;/b&gt; &lt;span style=&quot;font-size:10px&quot;&gt;(endpoints privados, identidad administrada, cifrado con llaves administradas por el banco)&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#FFFFFF);strokeColor=light-dark(#5F6B7A,#5F6B7A);strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=5;fontSize=11;fontColor=light-dark(#1a1a1a,#1a1a1a);" vertex="1" parent="1"><mxGeometry x="530" y="840" width="840" height="590" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure SQL Database&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;BD de Transferencias, Riesgo, Onboarding y Notificaciones, y libro mayor de auditoría; zona-redundante&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="890" width="780" height="72" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure Cosmos DB&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Modelo de lectura de movimientos; zona-redundante&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="978" width="780" height="72" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure Cache for Redis Premium&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Espacios de llaves por servicio; zona-redundante&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="1066" width="780" height="72" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure Service Bus Premium&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Temas y colas; zona-redundante&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="1154" width="780" height="72" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure Blob Storage&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Archivo de auditoría, retención inmutable; ZRS&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=light-dark(#438DD5,#438DD5);strokeColor=light-dark(#3C7FC0,#3C7FC0);fontColor=light-dark(#ffffff,#ffffff);fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="1242" width="780" height="72" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Key Vault y Managed HSM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Llaves, secretos, certificados&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="1330" width="780" height="72" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Azure Monitor, Log Analytics, Defender for Cloud, Sentinel&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Nodo de despliegue: observabilidad y seguridad]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Telemetría de cada nodo (OpenTelemetry), alertas, SIEM&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="530" y="1470" width="840" height="100" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Región de Azure: North Central US (recuperación ante desastres)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Espera en caliente, región pareja oficial de la primaria; sin zonas de disponibilidad&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=light-dark(#444444,#BDBDBD);verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=light-dark(#333333,#EAEAEA);fontSize=13;fontStyle=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1500" y="330" width="900" height="1290" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;API Management Premium&lt;/font&gt;&lt;/b&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;[Nodo de despliegue: API gateway, unidad secundaria, en espera]&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Contenedor API Gateway: validación de JWT, alcances, límites de tasa, enrutamiento&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#0078D4,#0078D4);strokeColor=light-dark(#005A9E,#005A9E);fontColor=light-dark(#ffffff,#ffffff);arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1530" y="400" width="840" height="100" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;Clúster de Azure Kubernetes Service&lt;/b&gt;&l